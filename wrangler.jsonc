{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idlemullet-router",
  "main": "server/worker.js",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Only the game's subpath. The idlemullet repo's worker owns the rest of idlemullet.com
  // (idlemullet.com/*); Cloudflare sends each request to the most specific matching route.
  "routes": [
    {
      "pattern": "idlemullet.com/idle-distribution*",
      "zone_name": "idlemullet.com"
    },
    {
      "pattern": "www.idlemullet.com/idle-distribution*",
      "zone_name": "idlemullet.com"
    }
  ]
}
