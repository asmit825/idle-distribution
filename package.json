{
  "name": "idle-distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/pallet_sim --target web --out-dir ../../pkg",
    "predev": "npm run build:wasm",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:wasm": "node --test tests/engine.test.mjs",
    "test:rust": "cargo test --manifest-path crates/pallet_sim/Cargo.toml",
    "test:unit": "vitest run src",
    "test:browser": "playwright test",
    "test": "npm run test:rust && npm run build:wasm && npm run test:wasm && npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.11",
    "wasm-pack": "^0.15.0"
  },
  "overrides": {
    "vite-plugin-top-level-await": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
